# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5

# Hotmart
HOTMART_WEBHOOK_SECRET=your-hotmart-hmac-secret

# Resend (envío del email de acceso al crear usuarios desde el panel admin)
RESEND_API_KEY=re_...

# Unsplash (fotos reales en la web del Día 3 y el Capability Statement).
# OPCIONAL: sin esta key se usa un fallback keyless (LoremFlickr), pero con la
# key las fotos son de mucha mejor calidad. Gratis: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
